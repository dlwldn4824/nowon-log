# ─────────────────────────────────────────────
# 골목픽 환경 변수 예시
# 1) 이 파일을 .env 로 복사하세요:  cp .env.example .env   (또는 npm run setup)
# 2) 아래 값을 채우세요. 앱 화면의 ⚙️ 설정에서 입력해도 .env 에 저장됩니다.
# .env 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않아요.
# ─────────────────────────────────────────────

# Claude API 키 (https://console.anthropic.com → API Keys)
# 비워 두면 '데모 모드'로 동작합니다 (샘플 데이터 + 규칙 기반 추천).
ANTHROPIC_API_KEY=

# 사용할 Claude 모델 (기본값 그대로 두면 됩니다)
ANTHROPIC_MODEL=claude-opus-5-5

# HeyYumi MCP 인증 토큰 (HeyYumi 팀에서 발급받은 토큰)
# 비워 두면 가게 데이터는 샘플 데이터를 사용합니다.
HEYYUMI_API_KEY=

# HeyYumi MCP 서버 주소 (보통 바꿀 필요 없음)
HEYYUMI_MCP_URL=https://mcp.heyyumi.ai/mcp

# 로컬 서버 포트
PORT=3000
